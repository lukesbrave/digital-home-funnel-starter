# Digital Home wiring. Exactly two values are required to go live.
# Both are SERVER-SIDE only: they never reach the browser bundle.
# Locally: copy to .env.local. On Cloudflare: set them as secrets
# (npx wrangler secret put FUNNEL_SECRET), never commit real values.

# 1. Your Digital Home backend URL (no trailing slash).
FUNNEL_BACKEND_URL=https://crm.yourdomain.com

# 2. The funnel secret: the crm_funnel_secret setting in your backend.
# Recommended: set crm_capture_key to the same value so lead capture
# works with this single secret.
FUNNEL_SECRET=

# Optional: only needed if your crm_capture_key differs from the
# funnel secret.
# FUNNEL_CAPTURE_KEY=

# Optional: a server-side Anthropic key enables AI enhancement of the
# visitor-specific result sections. Everything works without it.
# ANTHROPIC_API_KEY=
